# Remember that LAMMPS 2005 uses only single words
# as commands, e.g. bond_style

############***Defining 108  Files***############################################

# (1) Initialization
units                   real     #determines the units to be used
dimension               3        #2 run either 3D or 2D simulation
boundary                p p p    # boundary conditions wether periodic etc.
newton                  on       # processors communicate to inform pairwise intercation
atom_style              full     #
#processors             2 2 2

#kspace_style            pppm 1.0e-5  #ewald
#pair_style             lj/cut 12
#pair_style             lj/cut/coul/cut 12 12
pair_style              lj/cut/coul/long 12 12
#kspace_modify          :qmesh 0 0 0 order 5 gewald 0 slab 3.0
bond_style              harmonic
angle_style             harmonic
dihedral_style          harmonic
improper_style          cvff

# (2) Atom definition
# Define file names
variable fname string ${basename}

# Check if the restart file exists and store the result in a variable
shell if test -e ${fname}_1.restart; then echo 1; else echo 0; fi > restart_flag.txt
variable restart_flag file restart_flag.txt
print "Restart flag: ${restart_flag}"

# Conditional logic to read the appropriate file
if "${restart_flag} == 1" then "read_restart ${fname}_1.restart" else "read_data ${fname}.data"

kspace_style            pppm 1.0e-5 #ewald

#change_box             all triclinic

# (3) Settings
neighbor                2.0 bin  
special_bonds           lj/coul 0.0 0.0 1.0
# (4) Minimization: con.grad. (cg)/steep.desc. (sd, somewt. more stable)
#min_style               cg
# thermo                 100
#dump                    0 all dcd 100 ASEN_0_nolong_NPT.dcd                        
#minimize                0.0001 0.0001 200 1000   #syntax etol ftol maxiter maxeval
#undump                  0
#reset_timestep  0

# (5) Dynamics
timestep                1    #since units is real timestep is in femtosecond
#neigh_modify           one 2000 page 100000  %Default is used
velocity                all create 298.15 12345 rot yes dist gaussian #Seed=48 not sure
#fix                    1 all npt temp 298.15 298.15 100 iso  1 1 1000 #Tdamp=100 Pdamp=1000 suggested by website
#fix                    2 all recenter INIT INIT INIT units box
fix                     1 all npt temp 298.15 298.15 100 aniso  1 1 1000 #Tdamp=100 Pdamp=1000 suggested by website
#fix                    1 all nvt temp 298.15 298.15 100
group                   cdc type 1 #1
#fix                     10 octa_1 ave/histo 10 10 100 -180 180 20 file temp.histo ave one beyond extra

thermo_style            custom step tpcpu etotal density ke temp pe ebond eangle edihed eimp evdwl ecoul elong press pxx pyy pzz pxy pxz pyz lx ly lz cellalpha cellbeta cellgamma vol
thermo                  2500


dump                   2 all atom 50000 ${fname}.dump
#dump                   3 all custom 2500 tmp_!name.dump step c_1 c_2 c_3 c_4 c_5 c_6
#dump_modify           2 unwrap yes
      
restart                10000 ${fname}_1.restart ${fname}_2.restart    #write the restart file
run                    500000    #simulation runs for (run_value)*(timestep_value)*10^(-6) nanosec

write_restart           ${fname}_final.restart       
